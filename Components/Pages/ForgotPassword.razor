@page "/forgot-password"
@layout ZU_AuditIntel.Web.Components.Layout.EmptyLayout

<PageTitle>@T("استعادة كلمة المرور - ZU-AuditIntel")</PageTitle>

<div class="zu-fp-wrapper" dir="@Ui.Dir">
	<div class="zu-fp-card">
		<div class="zu-fp-header">
			<h2>@T("استعادة كلمة المرور")</h2>
			<p>@T("وحدة الاعتماد وضمان الجودة") &mdash; ZU-AuditIntel</p>
		</div>

		<div class="zu-fp-note">
			@T("لا يتحقق هذا النظام من بياناتك ولا يرسلها ولا يحفظها: بوابة الجامعة هي التي تتحقق وتعيد تعيين كلمة المرور. اكتب رقمك الوظيفي، ونفتح لك البوابة الصحيحة في تبويب جديد، ثم يعود هذا التبويب إلى الصفحة الرئيسية.")
		</div>

		<div class="zu-fp-error" id="zu-fp-error" hidden>@T("أدخل رقمك الوظيفي: من رقمين إلى عشرة أرقام.")</div>

		<form id="zu-fp-form" onsubmit="zuForgotNext(); return false;">
			<div class="zu-fp-group">
				<label class="zu-fp-label" for="zu-fp-employee">@T("الرقم الوظيفي")</label>
				<input class="zu-fp-input" id="zu-fp-employee" type="text" inputmode="numeric" autocomplete="username"
					   placeholder="@T("أدخل رقمك الوظيفي...")" />
			</div>

			<button type="submit" class="zu-fp-submit">@T("التالي")</button>
			@* تحميل كامل كالذهاب إليها: الملاحة المحسَّنة لا تنفّذ سكربت صفحة الدخول فأزرارها تصير صمّاء. *@
			<a href="/login" class="zu-fp-back" data-enhance-nav="false">@T("العودة إلى تسجيل الدخول")</a>
		</form>

		<div class="zu-fp-wait" id="zu-fp-wait" hidden>@T("جارٍ فتح البوابة في تبويب جديد، ويعود هذا التبويب إلى الصفحة الرئيسية…")</div>

		@* لو منع مانعُ النوافذ التبويبَ لم نُغادر: الرابطان تحته تحميلٌ حقيقي بيد صاحبه، والعودة تُجدوَل بلمسته. *@
		<div class="zu-fp-blocked" id="zu-fp-blocked" hidden>
			<span>@T("منع المتصفح فتح التبويب وحده. افتحه من هذا الرابط:")</span>
			<a id="zu-fp-manual-academic" class="zu-fp-manual" href="https://staff.zu.edu.jo/Admin/ForgetPassword"
			   target="_blank" rel="noopener" onclick="zuForgotScheduleReturn()" hidden>@T("بوابة أعضاء هيئة التدريس")</a>
			<a id="zu-fp-manual-employee" class="zu-fp-manual" href="https://eservices.zu.edu.jo/zemp_gate/Login/NewforgetPass"
			   target="_blank" rel="noopener" onclick="zuForgotScheduleReturn()" hidden>@T("بوابة الموظفين")</a>
		</div>
	</div>
</div>

<style>
	.zu-fp-wrapper {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #f4f6fb;
		padding: 1.5rem;
	}

	.zu-fp-card {
		background: #fff;
		border-radius: 1.25rem;
		box-shadow: 0 10px 30px rgba(13, 110, 253, .08);
		padding: 2rem;
		width: 100%;
		max-width: 480px;
	}

	.zu-fp-header h2 {
		color: #0d6efd;
		font-weight: 700;
		font-size: 1.35rem;
		margin: 0;
	}

	.zu-fp-header p {
		color: #6c757d;
		font-size: .9rem;
		margin: .25rem 0 1.25rem;
	}

	.zu-fp-note {
		background: #eef4ff;
		color: #1b4b91;
		border: 1px solid #cfe1ff;
		border-radius: .75rem;
		padding: .75rem 1rem;
		font-size: .84rem;
		line-height: 1.7;
		margin-bottom: 1.25rem;
	}

	.zu-fp-error {
		background: #fdecea;
		color: #a12622;
		border: 1px solid #f5c2c7;
		border-radius: .75rem;
		padding: .75rem 1rem;
		font-size: .9rem;
		margin-bottom: 1rem;
	}

	.zu-fp-wait {
		background: #eef4ff;
		color: #1b4b91;
		border: 1px solid #cfe1ff;
		border-radius: .75rem;
		padding: .75rem 1rem;
		font-size: .9rem;
		line-height: 1.7;
		margin-bottom: 1rem;
	}

	.zu-fp-blocked {
		background: #fff6e5;
		color: #8a5a10;
		border: 1px solid #f3d9a8;
		border-radius: .75rem;
		padding: .75rem 1rem;
		font-size: .84rem;
		line-height: 1.9;
		margin-bottom: 1rem;
	}

	.zu-fp-manual {
		color: #2563eb;
		font-weight: 700;
		text-decoration: underline;
	}

	.zu-fp-group {
		margin-bottom: 1rem;
	}

	.zu-fp-label {
		display: block;
		font-size: .85rem;
		font-weight: 600;
		color: #34495e;
		margin-bottom: .35rem;
	}

	.zu-fp-input {
		width: 100%;
		border: 1px solid #dfe4ea;
		border-radius: .75rem;
		padding: .7rem .9rem;
		font-size: .95rem;
		color: #1e293b;
		background: #f9fbff;
	}

		.zu-fp-input:focus {
			outline: 2px solid rgba(13, 110, 253, .35);
			border-color: #0d6efd;
			background: #fff;
		}

	.zu-fp-submit {
		width: 100%;
		border: 0;
		border-radius: .75rem;
		background: linear-gradient(90deg, #0d6efd, #6ea8fe);
		color: #fff;
		font-weight: 700;
		padding: .8rem;
		cursor: pointer;
	}

	.zu-fp-back {
		display: block;
		text-align: center;
		color: #2563eb;
		font-weight: 600;
		text-decoration: underline;
		margin-top: .9rem;
		font-size: .84rem;
	}
</style>

<script>
	var zuFpEmployee = "";
	var zuFpReturnTimer = null;
	// مهلة قصيرة وحدها: صاحبه انتقل إلى تبويب البوابة، فبقاء هذا التبويب معلّقاً على شاشةٍ قرأها عبث.
	var zuFpReturnDelay = 1500;

	// الصفة تُقرأ من جدول المستخدمين: الكادر الأكاديمي إلى بوابة التدريس ومن عداه إلى بوابة الموظفين.
	// ومن لا رقم له في الجدول ترجع له النقطة تصنيفَ طول الرقم نفسه، فلا يفرّق زائر بين «موظف» و«لا حساب».
	function zuForgotNext() {
		var raw = document.getElementById('zu-fp-employee').value.trim();
		var valid = /^\d{2,10}$/.test(raw);
		document.getElementById('zu-fp-error').hidden = valid;
		if (!valid)
			return;

		zuFpEmployee = raw;
		document.getElementById('zu-fp-form').hidden = true;
		document.getElementById('zu-fp-blocked').hidden = true;
		document.getElementById('zu-fp-wait').hidden = false;

		// التسليم قبل الطلب وقبل الفتح: الحافظة تطلب أن يكون هذا التبويب هو الناشط لحظة الكتابة.
		zuForgotHandOver();

		fetch('/account/staff-kind?employeeId=' + encodeURIComponent(raw), { credentials: 'same-origin' })
			.then(function (response) {
				if (!response.ok)
					throw new Error('staff-kind');
				return response.json();
			})
			.then(function (body) { zuForgotOpen(body.kind === 'academic' ? 'academic' : 'employee'); })
			.catch(function () { zuForgotOpen(raw.length <= 5 ? 'academic' : 'employee'); });
	}

	// بلا «noopener» في الوسائط: المتصفح يردّ منها null وقد فُتح التبويب فعلاً. نقطع الصلة يدوياً بعد
	// الفتح لنأخذ الأمانين معاً: مقبضٌ صادق على النافذة، ولا «window.opener» للبوابة تتحكم به. ومتى
	// رجع null حقاً لم نُغادر التبويب: نُظهر رابط البوابة ليفتحها صاحبها بلمسته.
	function zuForgotOpen(kind) {
		var url = kind === 'academic'
			? 'https://staff.zu.edu.jo/Admin/ForgetPassword'
			: 'https://eservices.zu.edu.jo/zemp_gate/Login/NewforgetPass';
		var tab = window.open(url, '_blank');
		if (tab)
			tab.opener = null;

		if (tab === null) {
			zuForgotBlocked(kind);
			return null;
		}

		zuForgotScheduleReturn();
		return tab;
	}

	function zuForgotBlocked(kind) {
		document.getElementById('zu-fp-wait').hidden = true;
		document.getElementById('zu-fp-manual-academic').hidden = kind !== 'academic';
		document.getElementById('zu-fp-manual-employee').hidden = kind !== 'employee';
		document.getElementById('zu-fp-blocked').hidden = false;
	}

	// التبويب الأساسي يعود إلى الصفحة الرئيسية من نفسه: صاحبه أكمل في تبويب البوابة.
	function zuForgotScheduleReturn() {
		if (zuFpReturnTimer !== null)
			clearTimeout(zuFpReturnTimer);

		zuFpReturnTimer = window.setTimeout(function () {
			zuFpReturnTimer = null;
			window.location.assign('/');
		}, zuFpReturnDelay);
	}

	// عبورٌ صامت بلا وعد: يُكتب الرقم في الحافظة إن سمح المتصفح، وإن أبى لم نُعلن شيئاً ولم نكذب؛
	// وصاحبه كتب رقمه بيده قبل لحظة، فيكتبه هناك إن لم يجد ما يلصقه.
	function zuForgotHandOver() {
		if (!zuFpEmployee)
			return;

		var done = function () { };
		if (navigator.clipboard && navigator.clipboard.writeText) {
			navigator.clipboard.writeText(zuFpEmployee).then(done, function () { zuFpFallbackCopy(zuFpEmployee, done, done); });
		} else {
			zuFpFallbackCopy(zuFpEmployee, done, done);
		}
	}

	function zuFpFallbackCopy(text, done, failed) {
		var area = document.createElement('textarea');
		area.value = text;
		area.setAttribute('readonly', 'readonly');
		area.style.position = 'fixed';
		area.style.opacity = '0';
		document.body.appendChild(area);
		area.select();
		var copied = false;
		try {
			copied = document.execCommand('copy');
		} catch (e) {
			copied = false;
		}
		document.body.removeChild(area);
		(copied ? done : failed)();
	}
</script>
