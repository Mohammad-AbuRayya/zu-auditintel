@page "/messages"
@layout ZU_AuditIntel.Web.Components.Layout.BoardLayout
@rendermode InteractiveServer
@attribute [Authorize]
@inject IMessageStore MessageStore
@inject IJSRuntime JS

<PageTitle>@T("الرسائل | ZU-AuditIntel")</PageTitle>

<div dir="@Ui.Dir" class="zu-msg-page">
    <div class="container px-0">
        <PageHeader Title="@T("الرسائل")">
            @if (Unread > 0)
            {
                <span class="badge rounded-pill text-bg-danger">@F("{0} غير مقروءة", Unread)</span>
            }
        </PageHeader>

        <div class="row g-3">
            @* قائمة المحادثات في جهة البداية، ونافذة المحادثة في الطرف الآخر. *@
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 zu-msg-list h-100">
                    <div class="card-header bg-white border-0 rounded-top-4 px-3 py-3 d-flex align-items-center gap-2">
                        @if (Picking)
                        {
                            <button type="button" class="btn btn-sm btn-light rounded-3" title="@T("رجوع إلى المحادثات")"
                                    @onclick="ClosePicker">
                                <i class="bi @(Ui.IsEnglish ? "bi-arrow-left" : "bi-arrow-right")"></i>
                            </button>
                            <div class="fw-bold">@T("اختر جهة للمراسلة")</div>
                        }
                        else
                        {
                            <div class="fw-bold">@T("المحادثات")</div>
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">@Threads.Count</span>
                            <button type="button" class="btn btn-sm btn-primary rounded-3 ms-auto d-inline-flex align-items-center gap-1"
                                    @onclick="OpenPicker">
                                <i class="bi bi-plus-lg"></i> @T("محادثة جديدة")
                            </button>
                        }
                    </div>

                    @if (Picking)
                    {
                        <div class="px-3 py-2 border-bottom">
                            <input type="search" class="form-control form-control-sm" @bind="ContactQuery" @bind:event="oninput"
                                   placeholder="@T("ابحث بالاسم أو المسمى الوظيفي")" aria-label="@T("ابحث بالاسم أو المسمى الوظيفي")" />
                        </div>
                        <div class="zu-msg-scroll">
                            @if (ShownContacts.Count == 0)
                            {
                                <div class="text-center text-muted py-5 small">
                                    <i class="bi bi-person-x"></i> @T("لا أحد يطابق هذا البحث")
                                </div>
                            }
                            @foreach (var contact in ShownContacts)
                            {
                                <button type="button" class="zu-person" @onclick="() => OpenThreadAsync(contact.EmployeeId)">
                                    <span class="zu-person-avatar">@Initials(contact.FullName)</span>
                                    <span class="zu-person-main">
                                        <span class="zu-person-name">@Person(contact.FullName)</span>
                                        <span class="zu-person-sub">@Subtitle(contact)</span>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                    else if (Threads.Count == 0)
                    {
                        <div class="text-center text-muted py-5 small px-3">
                            <i class="bi bi-chat-dots"></i> @T("لا محادثات بعد — ابدأ واحدة بزر «محادثة جديدة»")
                        </div>
                    }
                    else
                    {
                        <div class="zu-msg-scroll">
                            @foreach (var thread in Threads)
                            {
                                var picked = Selected?.EmployeeId == thread.OtherEmployeeId;
                                <button type="button" class="zu-person @(picked ? "active" : "")"
                                        @onclick="() => OpenThreadAsync(thread.OtherEmployeeId)">
                                    <span class="zu-person-avatar">@Initials(thread.OtherName)</span>
                                    <span class="zu-person-main">
                                        <span class="zu-person-name">@Person(thread.OtherName)</span>
                                        <span class="zu-person-last">
                                            @(thread.LastFromMe ? T("أنت: ") : "")@thread.LastBody
                                        </span>
                                    </span>
                                    <span class="zu-person-side">
                                        <span class="zu-person-time">@thread.LastAt.ToString("yyyy/MM/dd")</span>
                                        @if (thread.UnreadCount > 0)
                                        {
                                            <span class="zu-person-badge">@thread.UnreadCount</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-8">
                @if (Selected is null)
                {
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                            <div class="zu-msg-empty mx-auto mb-3"><i class="bi bi-chat-square-text"></i></div>
                            <h2 class="h5 fw-bold mb-2">@T("اختر محادثة أو ابدأ واحدة جديدة")</h2>
                            <p class="text-muted mb-0" style="max-width:34rem;">
                                @T("كل جهة تراسل من لها به عمل: رئيس وحدة التطوير وضمان الجودة، وصاحب النتيجة النهائية، وزميلها في الجهة نفسها.")
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="card-header bg-white border-0 rounded-top-4 px-3 py-3 d-flex align-items-center gap-2">
                            <span class="zu-person-avatar zu-chat-avatar">@Initials(Selected.FullName)</span>
                            <div class="min-w-0">
                                <div class="fw-bold text-truncate">@Person(Selected.FullName)</div>
                                <div class="small text-muted text-truncate">@Subtitle(Selected)</div>
                            </div>
                        </div>

                        <div class="zu-chat-body" id="zu-chat-body">
                            @if (Thread is null || Thread.Messages.Count == 0)
                            {
                                <div class="zu-chat-start">
                                    @F("لا رسائل بينك وبين {0} بعد.", Person(Selected.FullName))
                                </div>
                            }
                            @foreach (var message in Thread?.Messages ?? [])
                            {
                                <div class="zu-bubble @(message.IsMine ? "zu-bubble-mine" : "zu-bubble-theirs")">
                                    <div class="zu-bubble-text">@message.Body</div>
                                    <div class="zu-bubble-time">@message.SentAt.ToString("yyyy/MM/dd HH:mm")</div>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white border-0 p-3">
                            @if (Error is not null)
                            {
                                <div class="alert alert-danger py-2 small rounded-3 mb-2">@Error</div>
                            }
                            <div class="d-flex align-items-end gap-2">
                                <textarea class="form-control" rows="2" maxlength="2000" @bind="Draft"
                                          placeholder="@T("اكتب رسالتك…")" aria-label="@T("اكتب رسالتك…")"></textarea>
                                <button type="button" class="btn btn-primary rounded-3 d-inline-flex align-items-center gap-1 px-3"
                                        disabled="@(IsBusy || string.IsNullOrWhiteSpace(Draft))" @onclick="SendAsync">
                                    <i class="bi bi-send"></i> @T("إرسال")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private MessageViewer Viewer = new("", "", null, null);
    private IReadOnlyList<MessageThreadRow> Threads = [];
    private IReadOnlyList<MessageContact> Contacts = [];

    /// <summary>الطرف الآخر في المحادثة المفتوحة؛ null قبل اختيار واحدة.</summary>
    private MessageContact? Selected;

    /// <summary>محادثة الطرف المختار؛ null إن لم يتبادلا رسالة بعد.</summary>
    private MessageThreadView? Thread;

    private bool Picking;
    private string ContactQuery = string.Empty;
    private string Draft = string.Empty;
    private string? Error;
    private int Unread;
    private bool IsBusy;

    private IReadOnlyList<MessageContact> ShownContacts
    {
        get
        {
            var query = ContactQuery.Trim();
            if (query.Length == 0)
                return Contacts;

            return Contacts
                .Where(c => Person(c.FullName).Contains(query, StringComparison.OrdinalIgnoreCase)
                    || T(c.JobTitle).Contains(query, StringComparison.OrdinalIgnoreCase)
                    || (c.DepartmentName is not null && T(c.DepartmentName).Contains(query, StringComparison.OrdinalIgnoreCase))
                    || c.EmployeeId.Contains(query, StringComparison.Ordinal))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        Viewer = MessageViewer.From((await AuthState).User);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        Threads = await MessageStore.ListThreadsAsync(Viewer);
        Unread = Threads.Sum(t => t.UnreadCount);
    }

    private void OpenPicker()
    {
        Picking = true;
        ContactQuery = string.Empty;
    }

    private void ClosePicker() => Picking = false;

    /// <summary>فتح محادثة قراءةٌ: المخزن يعلّم رسائل الطرف الآخر مقروءة قبل أن يعيدها.</summary>
    private async Task OpenThreadAsync(string otherEmployeeId)
    {
        Picking = false;
        Error = null;
        Draft = string.Empty;
        IsBusy = true;

        var view = await MessageStore.GetThreadAsync(Viewer, otherEmployeeId);
        Thread = view;
        Selected = view?.Other ?? Contacts.FirstOrDefault(c => c.EmployeeId == otherEmployeeId);

        await RefreshAsync();
        IsBusy = false;
        ScrollPending = true;
    }

    private async Task SendAsync()
    {
        if (Selected is null || string.IsNullOrWhiteSpace(Draft))
            return;

        IsBusy = true;
        Error = null;

        var view = await MessageStore.SendAsync(Viewer, Selected.EmployeeId, Draft);
        if (view is null)
        {
            Error = T("تعذّر إرسال الرسالة. حاول مرة أخرى.");
        }
        else
        {
            Thread = view;
            Selected = view.Other;
            Draft = string.Empty;
        }

        await RefreshAsync();
        IsBusy = false;
        ScrollPending = true;
    }

    /// <summary>تمرير إلى آخر رسالة بعد كل فتح أو إرسال: الجديد أسفل النافذة لا في أعلاها.</summary>
    private bool ScrollPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ScrollPending)
            return;

        ScrollPending = false;
        await JS.InvokeVoidAsync("zuScrollToEnd", "zu-chat-body");
    }

    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length switch
        {
            0 => "",
            1 => words[0][..1],
            _ => $"{words[0][..1]}{words[1][..1]}"
        };
    }

    /// <summary>المسمّى الوظيفي ثم الجهة، ومن لا جهة له (رئيس الوحدة وصاحب النتيجة) يبقى بمسمّاه.</summary>
    private static string Subtitle(MessageContact contact) => contact.DepartmentName is null
        ? T(contact.JobTitle)
        : $"{T(contact.JobTitle)} · {T(contact.DepartmentName)}";
}

<style>
    .zu-msg-page {
        background-color: #f8f9fa;
        min-height: 100vh;
    }

    .zu-msg-list {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* القائمة تطول مع المحادثات، فتتمرّر وحدها ويبقى رأس البطاقة ثابتاً. */
    .zu-msg-scroll {
        max-height: 64vh;
        overflow-y: auto;
    }

    /* سطر شخص واحد في المحادثات أو في قائمة الاختيار: صورة واسم وسطر ثانٍ ووقت. */
    .zu-person {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 12px 14px;
        border: 0;
        border-bottom: 1px solid #eef2f7;
        background: none;
        text-align: start;
    }

        .zu-person:hover {
            background: #f5f9ff;
        }

        .zu-person.active {
            background: #e7f1ff;
        }

    .zu-person-avatar {
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: 13px;
        background: #eef4ff;
        border: 1px solid #dbe6ff;
        color: #0d6efd;
        font-weight: 800;
        font-size: .85rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .zu-chat-avatar {
        width: 46px;
        height: 46px;
        border-radius: 14px;
    }

    .zu-person-main {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        flex: 1;
    }

    .zu-person-name {
        font-weight: 700;
        color: #1e293b;
        font-size: .95rem;
    }

    .zu-person-sub,
    .zu-person-last {
        font-size: .78rem;
        color: #64748b;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .zu-person-side {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex: none;
    }

    .zu-person-time {
        font-size: .72rem;
        color: #94a3b8;
    }

    .zu-person-badge {
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: #0d6efd;
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .zu-msg-empty {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: #0d6efd;
        background: rgba(13, 110, 253, .08);
    }

    /* نافذة المحادثة: رأس ثابت، وسطٌ يتمرّر، وشريط كتابة في الأسفل. */
    .zu-chat-body {
        height: min(56vh, 540px);
        overflow-y: auto;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #f8fafc;
    }

    .zu-chat-start {
        margin: auto;
        text-align: center;
        font-size: .85rem;
        color: #94a3b8;
    }

    .zu-bubble {
        max-width: 74%;
        padding: 10px 14px;
        border-radius: 16px;
    }

    /* رسائلي إلى الطرف الآخر من السطر، ورسائل الطرف الآخر إلى البداية. */
    .zu-bubble-theirs {
        align-self: flex-start;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-start-start-radius: 6px;
    }

    .zu-bubble-mine {
        align-self: flex-end;
        background: #0d6efd;
        color: #fff;
        border-start-end-radius: 6px;
    }

    .zu-bubble-text {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.75;
        font-size: .95rem;
    }

    .zu-bubble-time {
        margin-top: 4px;
        font-size: .7rem;
        opacity: .72;
    }

    .min-w-0 {
        min-width: 0;
    }

    /* المظهر الليلي: السطور والفقاعات تُقلب مع بطاقات الليل. */
    html[data-bs-theme="dark"] .zu-msg-page {
        background-color: #0f1523;
    }

    html[data-bs-theme="dark"] .zu-chat-body {
        background: #0f1523;
    }

    html[data-bs-theme="dark"] .zu-bubble-theirs {
        background: #17202f;
        border-color: #26334a;
        color: #dbe4f0;
    }

    html[data-bs-theme="dark"] .zu-person {
        border-bottom-color: #26334a;
    }

        html[data-bs-theme="dark"] .zu-person:hover {
            background: rgba(13, 110, 253, .10);
        }

        html[data-bs-theme="dark"] .zu-person.active {
            background: rgba(13, 110, 253, .18);
        }

    html[data-bs-theme="dark"] .zu-person-name {
        color: #e8edf5;
    }

    html[data-bs-theme="dark"] .zu-person-avatar {
        background: #1d283a;
        border-color: #26334a;
        color: #7ab3ff;
    }
</style>
