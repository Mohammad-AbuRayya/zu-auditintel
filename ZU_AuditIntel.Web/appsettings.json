{
  "ConnectionStrings": {
    "AuditIntel": "Data Source=zu_auditintel.db;Default Timeout=30"
  },
  "AuditAi": {
    "BaseUrl": "http://127.0.0.1:8001",
    "TimeoutSeconds": 25,
    "PollIntervalSeconds": 2,
    "PollBudgetSeconds": 300,
    "MaxRetrievals": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
