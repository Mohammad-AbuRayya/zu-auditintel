<!DOCTYPE html>
@* اللغة تُقرأ من الطلب نفسه لا من الجافاسكربت، فلا يرتسم الصف بالعربية ثم ينقلب إنجليزية أمام المستخدم. *@
<html lang="@Ui.Lang" dir="@Ui.Dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // السمة تُقرأ وتُطبَّق قبل رسم الصفحة، وإلا لمح المستخدم أبيض ثم أسود عند كل فتح.
        (function () {
            var theme = 'light';
            try { theme = localStorage.getItem('zu-theme') === 'dark' ? 'dark' : 'light'; } catch (e) { }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ZU_AuditIntel.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["zu-dark.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["js/audit-shell.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
