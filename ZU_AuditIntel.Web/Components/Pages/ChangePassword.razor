@page "/account/change-password"
@layout ZU_AuditIntel.Web.Components.Layout.EmptyLayout
@attribute [Authorize]
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>تغيير كلمة المرور - ZU-AuditIntel</PageTitle>

<div class="zu-pw-wrapper" dir="rtl">
	<div class="zu-pw-card">
		<div class="zu-pw-header">
			<h2>تغيير كلمة المرور</h2>
			<p>وحدة الاعتماد وضمان الجودة — ZU-AuditIntel</p>
		</div>

		@if (ForcedChange)
		{
			<div class="zu-pw-note">
				هذا الحساب أُنشئ بكلمة مرور أولية. حدّد كلمة مرور خاصة بك قبل الدخول إلى لوحة التدقيق.
			</div>
		}

		@if (WeakPassword)
		{
			<div class="zu-pw-error">
				كلمة المرور يجب ألا تقل عن ٨ أحرف وأن تطابق حقل التأكيد.
			</div>
		}

		<form method="post" action="/account/change-password">
			<AntiforgeryField />

			<div class="zu-pw-group">
				<span class="zu-pw-label">كلمة المرور الجديدة</span>
				<input class="zu-pw-input" type="password" name="newPassword" autocomplete="new-password" required />
			</div>

			<div class="zu-pw-group">
				<span class="zu-pw-label">تأكيد كلمة المرور</span>
				<input class="zu-pw-input" type="password" name="confirmPassword" autocomplete="new-password" required />
			</div>

			<button type="submit" class="zu-pw-submit">حفظ كلمة المرور</button>
		</form>
	</div>
</div>

@code {
	private bool ForcedChange { get; set; }
	private bool WeakPassword { get; set; }

	protected override void OnInitialized()
	{
		var query = HttpContextAccessor.HttpContext?.Request.Query;
		ForcedChange = query?["forced"].ToString() == "1";
		WeakPassword = query?["error"].ToString() == "weak";
	}
}

<style>
	.zu-pw-wrapper {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #f4f6fb;
		padding: 1.5rem;
	}

	.zu-pw-card {
		background: #fff;
		border-radius: 1.25rem;
		box-shadow: 0 10px 30px rgba(13, 110, 253, .08);
		padding: 2rem;
		width: 100%;
		max-width: 420px;
	}

	.zu-pw-header h2 {
		color: #0d6efd;
		font-weight: 700;
		font-size: 1.35rem;
		margin: 0;
	}

	.zu-pw-header p {
		color: #6c757d;
		font-size: .9rem;
		margin: .25rem 0 1.25rem;
	}

	.zu-pw-note,
	.zu-pw-error {
		border-radius: .75rem;
		padding: .75rem 1rem;
		font-size: .9rem;
		margin-bottom: 1rem;
	}

	.zu-pw-note {
		background: #fff8e1;
		color: #7a5c00;
		border: 1px solid #ffe08a;
	}

	.zu-pw-error {
		background: #fdecea;
		color: #a12622;
		border: 1px solid #f5c2c7;
	}

	.zu-pw-group {
		margin-bottom: 1rem;
	}

	.zu-pw-label {
		display: block;
		font-size: .85rem;
		font-weight: 600;
		color: #34495e;
		margin-bottom: .35rem;
	}

	.zu-pw-input {
		width: 100%;
		border: 1px solid #dfe4ea;
		border-radius: .75rem;
		padding: .7rem .9rem;
		font-size: .95rem;
	}

	.zu-pw-input:focus {
		outline: 2px solid rgba(13, 110, 253, .35);
		border-color: #0d6efd;
	}

	.zu-pw-submit {
		width: 100%;
		border: 0;
		border-radius: .75rem;
		background: linear-gradient(90deg, #0d6efd, #6ea8fe);
		color: #fff;
		font-weight: 700;
		padding: .8rem;
	}
</style>
