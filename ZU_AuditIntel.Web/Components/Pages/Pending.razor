@page "/pending"
@layout ZU_AuditIntel.Web.Components.Layout.EmptyLayout
@attribute [Authorize]

<PageTitle>لوحة العمل | ZU-AuditIntel</PageTitle>

<div dir="rtl" class="zu-pending-page">
	<div class="container py-4">
		<div class="mb-3">
			<UserBar />
		</div>

		<div class="card border-0 shadow-sm rounded-4">
			<div class="card-body p-4 p-md-5 text-center">
				<div class="zu-pending-icon mx-auto mb-3">
					<i class="bi bi-cone-striped"></i>
				</div>
				<h1 class="h4 fw-bold mb-2">لوحتك لم تُبنَ بعد</h1>
				<p class="text-muted mb-4" style="max-width:46rem;margin-inline:auto;">
					اكتمل حتى الآن كتالوج دائرة المكتبة العامة فقط. لوحة جهة أو دور آخر
					(قائمة مراجعة ضابط الارتباط، أو موافقات رئيس وحدة الجودة) تُضاف في الطبقة التالية
					من بناء النظام: حفظ المخرجات وحالة الإرسال ثم وكلاء التدقيق.
				</p>
				@if (CanOpenLibraryBoard)
				{
					<a href="/LibraryAudit" class="btn btn-primary rounded-4 px-4">
						الانتقال إلى لوحة المكتبة
					</a>
				}
			</div>
		</div>
	</div>
</div>

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthState { get; set; }

	private bool CanOpenLibraryBoard { get; set; }

	protected override async Task OnInitializedAsync()
	{
		if (AuthState is null)
			return;

		var user = (await AuthState).User;
		CanOpenLibraryBoard = user.IsEntityRepresentative() && user.DepartmentId() == DepartmentIds.Library;
	}
}

<style>
	.zu-pending-page {
		background-color: #f8f9fa;
		min-height: 100vh;
	}

	.zu-pending-icon {
		width: 84px;
		height: 84px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.4rem;
		color: #0d6efd;
		background: rgba(13, 110, 253, .08);
	}
</style>
