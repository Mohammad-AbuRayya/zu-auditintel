@page "/"
@page "/login"
@layout ZU_AuditIntel.Web.Components.Layout.EmptyLayout
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>تسجيل الدخول - ZU-AuditIntel</PageTitle>

<div class="zu-login-wrapper" dir="rtl">
	<div class="zu-login-card">

		<!-- القسم الأيمن: نموذج تسجيل الدخول -->
		<div class="zu-form-section">
			<div class="zu-form-header">
				<h2>نظام التدقيق الداخلي الذكي</h2>
				<p>وحدة الاعتماد وضمان الجودة — ZU-AuditIntel</p>
			</div>

			@if (LoginError is not null)
			{
				<div class="zu-alert">
					@LoginError
				</div>
			}

			<form method="post" action="/account/login">
				<AntiforgeryField />

				<!-- حقل الرقم الوظيفي -->
				<div class="zu-input-group">
					<span class="zu-badge-label">الرقم الوظيفي </span>
					<input class="zu-input" type="text" name="employeeId" placeholder="أدخل رقمك الوظيفي..." autocomplete="username" />
				</div>

				<!-- حقل كلمة المرور مع زر الإظهار والإخفاء -->
				<div class="zu-input-group">
					<span class="zu-badge-label">كلمة المرور</span>
					<div class="zu-password-wrapper">
						<input id="zu-password" class="zu-input" type="password" name="password"
							   placeholder="أدخل كلمة المرور..." autocomplete="current-password" />
						<button type="button" class="zu-eye-btn" onclick="toggleZuPassword(this)" title="إظهار/إخفاء كلمة المرور">
							<span>👁️</span>
						</button>
					</div>
				</div>

				<button type="submit" class="zu-submit-btn">تسجيل الدخول</button>

				<div class="zu-forgot-wrapper">
					<a href="#" class="zu-forgot-link">هل نسيت كلمة السر ؟</a>
				</div>
			</form>
		</div>

		<!-- القسم الأيسر: الهوية البصرية لجامعة الزرقاء -->
		<div class="zu-brand-section">

			<!-- صورة شعار ISO 21001 -->
			<div class="zu-brand-logo-wrapper">
				<img src="/images/logo.jpg" alt="ISO 21001" class="zu-brand-logo" />
			</div>
			<div class="zu-brand-logo-wrapper">
				<img src="/images/zarqa-logo.jpeg" alt="جامعة الزرقاء" class="zu-brand-logo" />
			</div>

			<div class="zu-brand-titles">
				<h1>جامعة الزرقاء</h1>
				<h3>بوابة التدقيق والجودة الذكية</h3>
				<p>نظام مؤتمت متعدد الوكلاء لمطابقة معايير الجودة الأكاديمية والإدارية</p>
			</div>

			<div class="zu-waves"></div>
		</div>

	</div>
</div>

<style>
	/* الخلفية العامة */
	.zu-login-wrapper {
		min-height: 100vh;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		background-attachment: scroll;
		background-clip: border-box;
		background-color: rgba(0, 0, 0, 0);
		background-image: url('/images/Gemini_Generated_Image_k9keibk9keibk9ke.jpeg');
		background-origin: padding-box;
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		padding: 20px;
	}

	/* البطاقة الرئيسية المنقسمة */
	.zu-login-card {
		display: flex;
		width: 100%;
		max-width: 920px;
		min-height: 500px;
		background: #ffffff;
		border-radius: 26px;
		box-shadow: 0 20px 50px rgba(20, 60, 120, 0.18);
		overflow: hidden;
		border: 7px solid #ffffff;
	}

	/* قسم النموذج (الأيمن) */
	.zu-form-section {
		flex: 1.1;
		padding: 45px 40px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: #ffffff;
	}

	.zu-form-header {
		text-align: center;
		margin-bottom: 35px;
	}

		.zu-form-header h2 {
			color: #1e293b;
			font-weight: 800;
			font-size: 1.75rem;
			margin-bottom: 6px;
		}

		.zu-form-header p {
			color: #64748b;
			font-size: 0.92rem;
			margin: 0;
		}

	/* تنسيق الحقول مع الكبسولة الزرقاء العائمة */
	.zu-input-group {
		position: relative;
		margin-bottom: 28px;
	}

	.zu-badge-label {
		position: absolute;
		top: -12px;
		right: 18px;
		background: #3b7ddd;
		color: #ffffff;
		padding: 3px 16px;
		border-radius: 50px;
		font-size: 0.8rem;
		font-weight: 600;
		z-index: 2;
		box-shadow: 0 3px 8px rgba(59, 125, 221, 0.35);
	}

	.zu-input {
		width: 100%;
		padding: 15px 20px;
		background: #f4f6f9;
		border: 1.5px solid #e2e8f0;
		border-radius: 14px;
		font-size: 0.95rem;
		color: #1e293b;
		outline: none;
		transition: all 0.25s ease;
	}

		.zu-input:focus {
			background: #ffffff;
			border-color: #3b7ddd;
			box-shadow: 0 0 0 4px rgba(59, 125, 221, 0.12);
		}

	/* زر العين لكلمة المرور */
	.zu-password-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.zu-eye-btn {
		position: absolute;
		left: 14px;
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1.15rem;
		color: #3b7ddd;
		padding: 4px;
		display: flex;
		align-items: center;
	}

	/* زر تسجيل الدخول */
	.zu-submit-btn {
		width: 100%;
		padding: 14px;
		background: linear-gradient(90deg, #3b7ddd, #2863b8);
		color: #ffffff;
		border: none;
		border-radius: 14px;
		font-size: 1.05rem;
		font-weight: 700;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		box-shadow: 0 6px 18px rgba(59, 125, 221, 0.35);
		margin-top: 5px;
	}

		.zu-submit-btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 22px rgba(59, 125, 221, 0.45);
		}

	.zu-forgot-wrapper {
		text-align: center;
		margin-top: 18px;
	}

	.zu-forgot-link {
		color: #2563eb;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: underline;
	}

	.zu-alert {
		background: #fef2f2;
		color: #dc2626;
		border: 1px solid #fecaca;
		padding: 10px 14px;
		border-radius: 12px;
		margin-bottom: 22px;
		text-align: center;
		font-size: 0.9rem;
		font-weight: 600;
	}

	/* القسم الأيسر الأزرق (الهوية البصرية) */
	.zu-brand-section {
		flex: 1;
		background: linear-gradient(155deg, #4484e2 0%, #2561b8 100%);
		border-radius: 20px;
		color: #ffffff;
		padding: 40px 30px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	/* تنسيق الشعار الجديد */
	.zu-brand-logo-wrapper {
		margin-bottom: 22px;
		z-index: 2;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.zu-brand-logo {
		width: 155px;
		height: 155px;
		object-fit: contain;
		background-color: #ffffff;
		padding: 12px;
		border-radius: 24px;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
	}

	.zu-brand-titles {
		z-index: 2;
	}

		.zu-brand-titles h1 {
			font-size: 2rem;
			font-weight: 800;
			margin-bottom: 6px;
		}

		.zu-brand-titles h3 {
			font-size: 1.25rem;
			font-weight: 600;
			opacity: 0.95;
			margin-bottom: 12px;
		}

		.zu-brand-titles p {
			font-size: 0.85rem;
			opacity: 0.85;
			max-width: 280px;
			line-height: 1.6;
			margin: 0 auto;
		}

	/* التموجات السفلية */
	.zu-waves {
		position: absolute;
		bottom: -40px;
		left: -20%;
		width: 140%;
		height: 130px;
		background: rgba(255, 255, 255, 0.12);
		border-radius: 50%;
		z-index: 1;
		box-shadow: 0 -25px 0 rgba(255, 255, 255, 0.06);
	}

	/* التجاوب مع الشاشات الصغيرة */
	@@media (max-width: 768px) {
		.zu-login-card {
			flex-direction: column-reverse;
		}

		.zu-brand-section {
			padding: 30px 20px;
		}
	}
</style>

<script>
	function toggleZuPassword() {
		var input = document.getElementById('zu-password');
		input.type = input.type === 'password' ? 'text' : 'password';
	}
</script>

@code {
	private string? LoginError { get; set; }

	// النموذج يُرسل إلى نقطة API ثم يُعاد التوجيه هنا مع الخطأ في سلسلة الاستعلام، فلا حالة تبقى في المكوّن.
	protected override void OnInitialized()
	{
		LoginError = HttpContextAccessor.HttpContext?.Request.Query["error"].ToString() switch
		{
			"invalid" => "الرقم الوظيفي أو كلمة المرور غير صحيحة",
			"denied" => "لا تملك صلاحية الوصول إلى هذه الشاشة",
			"session" => "انتهت الجلسة، سجّل الدخول من جديد",
			_ => null
		};
	}
}
