@page "/"
@page "/login"
@layout ZU_AuditIntel.Web.Components.Layout.EmptyLayout
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@T("تسجيل الدخول - ZU-AuditIntel")</PageTitle>

<div class="zu-login-wrapper" dir="@Ui.Dir">
	<div class="zu-login-card">

		<!-- القسم الأيمن: نموذج تسجيل الدخول -->
		<div class="zu-form-section">
			<div class="zu-form-header">
				<h2>@T("نظام التدقيق الداخلي الذكي")</h2>
				<p>@T("وحدة الاعتماد وضمان الجودة") &mdash; ZU-AuditIntel</p>
			</div>

			@if (LoginError is not null)
			{
				<div class="zu-alert">
					@LoginError
				</div>
			}

			<form method="post" action="/account/login">
				<AntiforgeryField />

				<!-- حقل الرقم الوظيفي -->
				<div class="zu-input-group">
					<span class="zu-badge-label">@T("الرقم الوظيفي") </span>
					<input class="zu-input" type="text" name="employeeId" placeholder="@T("أدخل رقمك الوظيفي...")" autocomplete="username" />
				</div>

				<!-- حقل كلمة المرور مع زر الإظهار والإخفاء -->
				<div class="zu-input-group">
					<span class="zu-badge-label">@T("كلمة المرور")</span>
					<div class="zu-password-wrapper">
						<input id="zu-password" class="zu-input zu-password-input" type="password" name="password"
							   placeholder="@T("أدخل كلمة المرور...")" autocomplete="current-password" />
						@* الشاشة تُقدَّم من Server فلا حالة في المكوّن: الحقل وشكل الزر يقلبهما JavaScript معاً. *@
						<button type="button" id="zu-eye" class="zu-eye-btn" onclick="toggleZuPassword()"
								aria-pressed="false" aria-label="@T("إظهار كلمة المرور")"
								data-hidden-label="@T("إظهار كلمة المرور")" data-shown-label="@T("إخفاء كلمة المرور")">
							<i id="zu-eye-icon" class="zu-eye-glyph bi bi-eye"></i>
						</button>
					</div>
				</div>

				<button type="submit" class="zu-submit-btn">@T("تسجيل الدخول")</button>

				<div class="zu-forgot-wrapper">
					@* الملاحة المحسَّنة تنقل المحتوى ولا تنفّذ سكربت الصفحة الجديدة، فالرابط تحميل كامل. *@
					<a href="/forgot-password" class="zu-forgot-link" data-enhance-nav="false">@T("هل نسيت كلمة السر ؟")</a>
				</div>
			</form>

			@* زر اللغة في قرص مستقل أسفل رابط كلمة السر: يبقى داخل تدفّق النموذج فلا يطفو على البطاقة. *@
			<div class="zu-lang-wrapper">
				<button type="button" class="zu-lang-btn" onclick="zuToggleLanguage()"
						title="@T("تبديل لغة الموقع: العربية والإنجليزية")">
					<i class="bi bi-translate"></i>@(Ui.IsEnglish ? "English" : "العربية")
				</button>
			</div>
		</div>

		<!-- القسم الأيسر: الهوية البصرية لجامعة الزرقاء -->
		<div class="zu-brand-section">

			<h1 class="zu-brand-university">@T("جامعة الزرقاء")</h1>

			<!-- شعار الجامعة الدائري مع شعار ISO متداخلاً على زاويته اليسرى -->
			<div class="zu-brand-crest">
				<img src="/images/zu-logo.png" alt="@T("شعار جامعة الزرقاء")" class="zu-crest-university" />
				<img src="/images/iso-21001.jpeg" alt="@T("شعار ISO 21001")" class="zu-crest-iso" />
			</div>

			<div class="zu-brand-titles">
				<h3>@T("بوابة التدقيق والجودة الذكية")</h3>
				<p>@T("نظام مؤتمت متعدد الوكلاء لمطابقة معايير الجودة الأكاديمية والإدارية")</p>
			</div>

			<div class="zu-waves"></div>
		</div>

	</div>
</div>

<style>
	/* الخلفية العامة */
	.zu-login-wrapper {
		min-height: 100vh;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		background-attachment: scroll;
		background-clip: border-box;
		background-color: rgba(0, 0, 0, 0);
		background-image: url('/images/Login page background.jpeg');
		background-origin: padding-box;
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		padding: 20px;
	}

	/* البطاقة الرئيسية المنقسمة */
	.zu-login-card {
		display: flex;
		width: 100%;
		max-width: 920px;
		min-height: 500px;
		background: #ffffff;
		border-radius: 26px;
		box-shadow: 0 20px 50px rgba(20, 60, 120, 0.18);
		overflow: hidden;
		border: 7px solid #ffffff;
	}

	/* زر اللغة في قرص مستقل أسفل رابط كلمة السر: داخل تدفّق النموذج، لا يطفو فوق البطاقة. */
	.zu-lang-wrapper {
		text-align: center;
		margin-top: 20px;
	}

	.zu-lang-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border: 1px solid rgba(214, 229, 255, 0.95);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.92);
		color: #0d6efd;
		font-size: 0.92rem;
		font-weight: 700;
		padding: 9px 16px;
		cursor: pointer;
		box-shadow: 0 4px 14px rgba(20, 60, 120, 0.10);
		transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease;
	}

		.zu-lang-btn:hover {
			border-color: #9ec5fe;
			color: #1554c0;
		}

		/* الضغط يقلّب الشكل بالانكماش وتغميق اللون، بلا تعبئة الصندوق بالأزرق. */
		.zu-lang-btn:active {
			color: #0a4bb5;
			border-color: #6ea8fe;
			transform: scale(.96);
		}

	/* قسم النموذج (الأيمن) */
	.zu-form-section {
		flex: 1.1;
		padding: 45px 40px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: #ffffff;
	}

	.zu-form-header {
		text-align: center;
		margin-bottom: 35px;
	}

		.zu-form-header h2 {
			color: #1e293b;
			font-weight: 800;
			font-size: 1.75rem;
			margin-bottom: 6px;
		}

		.zu-form-header p {
			color: #64748b;
			font-size: 0.92rem;
			margin: 0;
		}

	/* تنسيق الحقول مع الكبسولة الزرقاء العائمة */
	.zu-input-group {
		position: relative;
		margin-bottom: 28px;
	}

	.zu-badge-label {
		position: absolute;
		top: -12px;
		right: 18px;
		background: #3b7ddd;
		color: #ffffff;
		padding: 3px 16px;
		border-radius: 50px;
		font-size: 0.8rem;
		font-weight: 600;
		z-index: 2;
		box-shadow: 0 3px 8px rgba(59, 125, 221, 0.35);
	}

	.zu-input {
		width: 100%;
		padding: 15px 20px;
		background: #f4f6f9;
		border: 1.5px solid #e2e8f0;
		border-radius: 14px;
		font-size: 0.95rem;
		color: #1e293b;
		outline: none;
		transition: all 0.25s ease;
	}

		.zu-input:focus {
			background: #ffffff;
			border-color: #3b7ddd;
			box-shadow: 0 0 0 4px rgba(59, 125, 221, 0.12);
		}

	/* زر العين: أيقونة عارية في نهاية الحقل، بلا قرص ولا إطار */
	.zu-password-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.zu-password-input {
		padding-inline-end: 48px;
	}

	.zu-eye-btn {
		position: absolute;
		inset-inline-end: 14px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		padding: 2px;
		font-size: 1.2rem;
		line-height: 1;
		color: #94a3b8;
		cursor: pointer;
		transition: color .18s ease, transform .18s ease;
	}

		.zu-eye-btn:hover {
			color: #3b7ddd;
		}

		/* الكلمة ظاهرة: الأيقونة تقلب عيناً مخطوفة وزرقة، وخلفية الحقل تبقى كما هي بلا أي تعبئة. */
		.zu-eye-btn--on {
			color: #2563eb;
		}

			.zu-eye-btn--on .zu-eye-glyph {
				transform: scale(1.08);
			}

	.zu-eye-glyph {
		display: inline-block;
		transition: transform .18s ease;
	}

	/* زر تسجيل الدخول */
	.zu-submit-btn {
		width: 100%;
		padding: 14px;
		background: linear-gradient(90deg, #3b7ddd, #2863b8);
		color: #ffffff;
		border: none;
		border-radius: 14px;
		font-size: 1.05rem;
		font-weight: 700;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		box-shadow: 0 6px 18px rgba(59, 125, 221, 0.35);
		margin-top: 5px;
	}

		.zu-submit-btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 22px rgba(59, 125, 221, 0.45);
		}

	.zu-forgot-wrapper {
		text-align: center;
		margin-top: 18px;
	}

	.zu-forgot-link {
		color: #2563eb;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: underline;
	}

	.zu-alert {
		background: #fef2f2;
		color: #dc2626;
		border: 1px solid #fecaca;
		padding: 10px 14px;
		border-radius: 12px;
		margin-bottom: 22px;
		text-align: center;
		font-size: 0.9rem;
		font-weight: 600;
	}

	/* القسم الأيسر الأزرق (الهوية البصرية) */
	.zu-brand-section {
		flex: 1;
		background: linear-gradient(155deg, #4484e2 0%, #2561b8 100%);
		border-radius: 20px;
		color: #ffffff;
		padding: 40px 30px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	/* الاسم فوق الشعار: الدائرة تحمل الاسم منحنياً داخلها، فوضعه بجانبها يكرّر النص ويصطدم بحافتها */
	.zu-brand-university {
		font-size: 1.7rem;
		font-weight: 800;
		letter-spacing: .5px;
		margin: 0 0 20px;
		z-index: 2;
	}

	.zu-brand-crest {
		position: relative;
		width: 196px;
		height: 196px;
		margin-bottom: 28px;
		z-index: 2;
	}

	.zu-crest-university {
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter: drop-shadow(0 14px 26px rgba(0, 0, 0, .3));
	}

	/* شارة ISO أصغر ومتداخلة على الزاوية اليسرى للشعار */
	.zu-crest-iso {
		position: absolute;
		left: -24px;
		bottom: -4px;
		width: 84px;
		height: 84px;
		object-fit: contain;
		background-color: #ffffff;
		border: 3px solid #ffffff;
		border-radius: 50%;
		padding: 5px;
		box-shadow: 0 8px 20px rgba(0, 0, 0, .28);
	}

	.zu-brand-titles {
		z-index: 2;
	}

		.zu-brand-titles h3 {
			font-size: 1.25rem;
			font-weight: 600;
			opacity: 0.95;
			margin-bottom: 12px;
		}

		.zu-brand-titles p {
			font-size: 0.85rem;
			opacity: 0.85;
			max-width: 280px;
			line-height: 1.6;
			margin: 0 auto;
		}

	/* التموجات السفلية */
	.zu-waves {
		position: absolute;
		bottom: -40px;
		left: -20%;
		width: 140%;
		height: 130px;
		background: rgba(255, 255, 255, 0.12);
		border-radius: 50%;
		z-index: 1;
		box-shadow: 0 -25px 0 rgba(255, 255, 255, 0.06);
	}

	/* التجاوب مع الشاشات الصغيرة */
	@@media (max-width: 768px) {
		.zu-login-card {
			flex-direction: column-reverse;
		}

		.zu-brand-section {
			padding: 30px 20px;
		}

		.zu-brand-university {
			font-size: 1.4rem;
			margin-bottom: 16px;
		}

		.zu-brand-crest {
			width: 158px;
			height: 158px;
			margin-bottom: 22px;
		}

		.zu-crest-iso {
			left: -18px;
			bottom: -2px;
			width: 66px;
			height: 66px;
			padding: 4px;
		}
	}
</style>

<script>
	function toggleZuPassword() {
		var input = document.getElementById('zu-password');
		var button = document.getElementById('zu-eye');
		var icon = document.getElementById('zu-eye-icon');
		var shown = input.type === 'password';

		input.type = shown ? 'text' : 'password';
		button.classList.toggle('zu-eye-btn--on', shown);
		button.setAttribute('aria-pressed', shown ? 'true' : 'false');
		button.setAttribute('aria-label', button.dataset[shown ? 'shownLabel' : 'hiddenLabel']);
		icon.className = 'zu-eye-glyph bi ' + (shown ? 'bi-eye-slash' : 'bi-eye');
		input.focus();
	}
</script>

@code {
	private string? LoginError { get; set; }

	// النموذج يُرسل إلى نقطة API ثم يُعاد التوجيه هنا مع الخطأ في سلسلة الاستعلام، فلا حالة تبقى في المكوّن.
	protected override void OnInitialized()
	{
		LoginError = HttpContextAccessor.HttpContext?.Request.Query["error"].ToString() switch
		{
			"invalid" => T("الرقم الوظيفي أو كلمة المرور غير صحيحة"),
			"denied" => T("لا تملك صلاحية الوصول إلى هذه الشاشة"),
			"session" => T("انتهت الجلسة، سجّل الدخول من جديد"),
			_ => null
		};
	}
}
